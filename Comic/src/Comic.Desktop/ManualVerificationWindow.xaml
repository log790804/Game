<Window x:Class="Comic.Desktop.ManualVerificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="HappyMH 手動驗證"
        Width="1120"
        Height="780"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="16,12"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="請親自完成網站驗證" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="完成後回到漫畫詳情頁，再按右下角「驗證完成並載入」。程式不會自動解答驗證。" />
                </StackPanel>
                <Button Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Click="OnReturnToMangaClick"
                        Content="回到漫畫頁" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="12"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <wv2:WebView2 x:Name="Browser"
                         AutomationProperties.Name="HappyMH 手動驗證瀏覽器" />
        </Border>

        <Border Grid.Row="2"
                Padding="16,10"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusTextBlock"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite"
                           Text="正在啟動安全瀏覽器…" />
                <Button Grid.Column="1"
                        Margin="12,0,8,0"
                        Click="OnRefreshClick"
                        Content="重新整理 (_R)" />
                <Button Grid.Column="2"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="OnCancelClick"
                        Content="取消" />
                <Button x:Name="CompleteButton"
                        Grid.Column="3"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="False"
                        Click="OnCompleteClick"
                        Content="驗證完成並載入 (_C)" />
            </Grid>
        </Border>
    </Grid>
</Window>
